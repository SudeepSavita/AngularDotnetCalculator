<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <!-- node_modules aur .angular ko VS scan na kare (slow hota hai) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**;$(SpaRoot).angular\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- ClientApp ki files bin folder me copy na ho -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**;$(SpaRoot).angular\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\3rdpartylicenses.txt" />
    <None Include="wwwroot\index.html" />
    <None Include="wwwroot\main-OUUADN3Y.js" />
    <None Include="wwwroot\polyfills-FFHMD2TL.js" />
    <None Include="wwwroot\styles-DECLJK7A.css" />
  </ItemGroup>

  <!-- Debug: agar wwwroot/index.html nahi hai to Angular automatically build hoga -->
  <Target Name="AngularBuildDebug" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug' And !Exists('wwwroot\index.html')">
    <Exec Command="node --version" ContinueOnError="false" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <!-- Release/Publish: hamesha fresh Angular build -->
  <Target Name="AngularBuildRelease" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

</Project>
